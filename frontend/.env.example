# FRONTEND ENVIRONMENT VARIABLES

# API CONFIGURATION
# Development (Spring Boot WebSocket Bridge)
WEBSOCKET_URL=ws://localhost:8080/api/v1/ws/realtime

# APPLICATION SETTINGS
APP_NAME=Tazrout Monitoring Dashboard
APP_VERSION=1.0.0-BETA

# FEATURE FLAGS
ENABLE_ANALYTICS=true
ENABLE_DEBUG_MODE=true

# LOCALIZATION
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,fr,ar

# REFRESH INTERVALS (in ms)
DATA_REFRESH_INTERVAL=5000
CHART_UPDATE_INTERVAL=10000